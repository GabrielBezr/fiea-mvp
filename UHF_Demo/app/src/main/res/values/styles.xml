<resources>

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.
    -->
<!--    <style name="AppBaseTheme" parent="android:Theme.Light">-->
    <!-- Bridge: libera os componentes Material sem mudar a aparência dos widgets
         atuais, porque herda de Theme.AppCompat.Light e só acrescenta atributos. -->
    <style name="AppBaseTheme" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
        -->
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <!-- As telas são android.app.Activity: o AppCompat repassa colorPrimary e
             colorAccent aos widgets nativos (campos, caixas de seleção, spinners). -->
        <item name="colorPrimary">@color/fiea_azul</item>
        <item name="colorPrimaryVariant">@color/fiea_azul_escuro</item>
        <item name="colorPrimaryDark">@color/fiea_azul_escuro</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- O azul claro da logo não tem contraste para controles; fica só decorativo. -->
        <item name="colorAccent">@color/fiea_azul</item>
        <item name="colorSecondary">@color/fiea_azul</item>
        <item name="colorSecondaryVariant">@color/fiea_azul_escuro</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorError">@color/erro</item>
        <!-- O AppCompat não define este: sem ele os AlertDialog nativos ignoram o tema. -->
        <item name="android:alertDialogTheme">@style/Theme.Fiea.Dialogo</item>
    </style>

    <!-- Abertura: azul desde a janela inicial, para não piscar outra cor antes do layout.
         No Android 12+ a versão em values-v31 pinta também a abertura do sistema. -->
    <style name="Theme.Fiea.Splash" parent="AppTheme">
        <item name="android:windowBackground">@color/fiea_azul</item>
        <item name="android:statusBarColor">@color/fiea_azul</item>
    </style>

    <style name="Theme.Fiea.Dialogo" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorPrimary">@color/fiea_azul</item>
        <item name="android:colorAccent">@color/fiea_azul</item>
        <item name="android:windowBackground">@drawable/fundo_dialogo</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Fiea.Dialogo.Botao</item>
    </style>

    <style name="Widget.Fiea.Dialogo.Botao" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Tipografia -->
    <style name="TextAppearance.Fiea" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Fiea.Corpo" />

    <style name="TextAppearance.Fiea.Titulo">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Fiea.Subtitulo">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Fiea.Legenda">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <!-- Contadores da leitura: lidos de longe, com o coletor na mão -->
    <style name="TextAppearance.Fiea.Contador">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- EPC: largura fixa para comparar caractere a caractere -->
    <style name="TextAppearance.Fiea.Mono">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <!-- Rótulo da navegação inferior: mesmo tamanho ativo e inativo, para o texto
         não pular ao trocar de aba. A cor vem de itemTextColor. -->
    <style name="TextAppearance.Fiea.Navegacao" parent="TextAppearance.AppCompat">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Botões (MaterialButton). Sem os insets de 6dp do Material, o alvo de
         48dp fica todo visível. -->
    <style name="Widget.Fiea.Botao" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">@dimen/alvo_toque</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">@dimen/raio_botao</item>
    </style>

    <style name="Widget.Fiea.Botao.Perigo">
        <item name="backgroundTint">@color/selector_botao_perigo</item>
    </style>

    <!-- Botão sobre fundo azul (abertura): branco com texto azul. -->
    <style name="Widget.Fiea.Botao.SobreAzul">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/fiea_azul</item>
        <item name="iconTint">@color/fiea_azul</item>
        <item name="rippleColor">@color/fiea_azul_fundo</item>
    </style>

    <style name="Widget.Fiea.Botao.Secundario" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/alvo_toque</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">@dimen/raio_botao</item>
        <item name="strokeColor">@color/selector_botao_contorno</item>
    </style>

    <style name="Widget.Fiea.Botao.Texto" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/alvo_toque</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">@dimen/raio_botao</item>
    </style>

    <!-- Contorno e texto vermelhos: ações que não têm volta, como encerrar a sessão. -->
    <style name="Widget.Fiea.Botao.Secundario.Perigo">
        <item name="android:textColor">@color/selector_texto_perigo</item>
        <item name="iconTint">@color/selector_texto_perigo</item>
        <item name="strokeColor">@color/selector_texto_perigo</item>
        <item name="rippleColor">@color/erro_fundo</item>
    </style>

    <!-- Ação com o ícone em cima do texto: três lado a lado cabem na largura do coletor. -->
    <style name="Widget.Fiea.Botao.Acao" parent="Widget.Fiea.Botao.Secundario">
        <item name="iconGravity">top</item>
        <item name="iconPadding">@dimen/espaco_4</item>
        <item name="android:paddingStart">@dimen/espaco_4</item>
        <item name="android:paddingEnd">@dimen/espaco_4</item>
        <item name="android:paddingTop">@dimen/espaco_8</item>
        <item name="android:paddingBottom">@dimen/espaco_8</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.Fiea.Botao.Acao.Perigo">
        <item name="android:textColor">@color/selector_texto_perigo</item>
        <item name="iconTint">@color/selector_texto_perigo</item>
        <item name="strokeColor">@color/selector_texto_perigo</item>
        <item name="rippleColor">@color/erro_fundo</item>
    </style>

    <!-- Contagem por situação (Pendências): número em cima, rótulo embaixo. -->
    <style name="Widget.Fiea.Contagem" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">0</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Fiea.ContagemRotulo" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <!-- Formulário: rótulo em cima, caixa com contorno embaixo. -->
    <style name="Widget.Fiea.Rotulo" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/espaco_4</item>
        <item name="android:textAppearance">@style/TextAppearance.Fiea.Legenda</item>
    </style>

    <style name="Widget.Fiea.Campo" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/alvo_toque</item>
        <item name="android:background">@drawable/fundo_campo</item>
        <item name="android:paddingStart">@dimen/espaco_12</item>
        <item name="android:paddingEnd">@dimen/espaco_12</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/texto_primario</item>
        <item name="android:textColorHint">@color/texto_dica</item>
    </style>

    <!-- O texto do item vem de item_spinner.xml; o padding final abre espaço para a seta. -->
    <style name="Widget.Fiea.Spinner" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/alvo_toque</item>
        <item name="android:background">@drawable/fundo_spinner</item>
        <item name="android:paddingEnd">36dp</item>
    </style>

    <!-- Selo de situação (sessão ativa, varredura em andamento). A cor vem do código. -->
    <style name="Widget.Fiea.Selo" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/espaco_8</item>
        <item name="android:paddingEnd">@dimen/espaco_8</item>
        <item name="android:background">@drawable/fundo_chip</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Card plano com contorno: sombra em lista atualizada a cada leitura pesa. -->
    <style name="Widget.Fiea.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">@dimen/raio_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/contorno</item>
        <item name="strokeWidth">@dimen/espessura_contorno</item>
        <item name="contentPadding">@dimen/espaco_16</item>
    </style>

    <style name="dialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:popupBackground">@android:color/transparent</item>
    </style>

    <style name="loading" parent="">
        <item name="android:indeterminate">true</item>
        <item name="android:indeterminateOnly">true</item>
        <item name="android:indeterminateDuration">1200</item>
    </style>
</resources>
