<?xml version="1.0" encoding="utf-8"?>
<!-- Caixa dos campos de formulário: contorno mais forte e azul quando em foco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/raio_botao" />
            <solid android:color="@color/fundo" />
            <stroke android:width="1dp" android:color="@color/contorno" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/raio_botao" />
            <solid android:color="@color/superficie" />
            <stroke android:width="2dp" android:color="@color/fiea_azul" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/raio_botao" />
            <solid android:color="@color/superficie" />
            <stroke android:width="1dp" android:color="@color/contorno_forte" />
        </shape>
    </item>
</selector>
