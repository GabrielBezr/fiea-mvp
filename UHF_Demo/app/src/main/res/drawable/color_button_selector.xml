<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo dos botões herdados do demo. O ripple dá o retorno do toque; o
     desabilitado tem cor própria (antes só mudava a cor da borda). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_claro">
    <item>
        <selector>
            <item android:state_enabled="false" android:drawable="@drawable/button_disenabled_background" />
            <item android:drawable="@drawable/color_button_background" />
        </selector>
    </item>
</ripple>
