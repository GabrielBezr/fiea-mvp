<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- O Inventário tem três telas, escolhidas só pelo estado em ScanActivity.atualizarStatus:
         sem sessão, a sessão (este card com os campos); com sessão, a sessão resumida e as
         salas da unidade (card_salas); com uma varredura aberta, a leitura (card_varredura
         e card_lista). -->

    <!-- RF04: sessão de inventário, uma por unidade -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_sessao"
        style="@style/Widget.Fiea.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_12"
        android:layout_marginTop="@dimen/espaco_12"
        android:layout_marginEnd="@dimen/espaco_12"
        app:contentPadding="@dimen/espaco_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_person"
                    android:tint="@color/fiea_azul" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_8"
                    android:layout_weight="1"
                    android:text="@string/tituloSessao"
                    android:textAppearance="@style/TextAppearance.Fiea.Subtitulo" />

                <TextView
                    android:id="@+id/tv_chip_sessao"
                    style="@style/Widget.Fiea.Selo"
                    android:visibility="gone" />

                <!-- Só sem sessão: reexportar e exportar .xls a última sala depois de encerrar,
                     e atualizar a lista do PC (ScanActivity.abrirMaisAcoes) -->
                <ImageButton
                    android:id="@+id/bt_mais_acoes_sessao"
                    android:layout_width="@dimen/alvo_toque"
                    android:layout_height="@dimen/alvo_toque"
                    android:layout_marginStart="@dimen/espaco_4"
                    android:layout_marginTop="-12dp"
                    android:layout_marginEnd="-12dp"
                    android:layout_marginBottom="-12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/descMaisAcoes"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/texto_secundario"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_sessao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_4"
                android:text="@string/sessaoInativa"
                android:textAppearance="@style/TextAppearance.Fiea.Legenda" />

            <LinearLayout
                android:id="@+id/grupo_campos_sessao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_8"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espaco_8"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.Fiea.Rotulo"
                        android:labelFor="@+id/spinner_unidade"
                        android:text="@string/lblUnidade" />

                    <!-- Unidades do cadastro do PC (ScanActivity.preencherUnidades). O campo
                         de texto abaixo só aparece quando o coletor ainda não tem essa lista. -->
                    <Spinner
                        android:id="@+id/spinner_unidade"
                        style="@style/Widget.Fiea.Spinner"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/et_unidade"
                        style="@style/Widget.Fiea.Campo"
                        android:hint="@string/hintUnidade"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tv_unidade_aviso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaco_4"
                        android:text="@string/unidadeSemLista"
                        android:textAppearance="@style/TextAppearance.Fiea.Legenda"
                        android:textColor="@color/alerta_texto"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.Fiea.Rotulo"
                        android:labelFor="@+id/et_operador"
                        android:text="@string/lblOperador" />

                    <EditText
                        android:id="@+id/et_operador"
                        style="@style/Widget.Fiea.Campo"
                        android:hint="@string/hintOperador"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/BtIniciarSessao"
                style="@style/Widget.Fiea.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_12"
                android:text="@string/btIniciarSessao"
                app:icon="@drawable/ic_play_arrow" />

            <!-- Com a sessão ativa: quanto da unidade já foi varrido e a técnica da próxima sala -->
            <LinearLayout
                android:id="@+id/grupo_progresso_salas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_8"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_progresso_salas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="sans-serif-medium"
                    android:textAppearance="@style/TextAppearance.Fiea.Corpo" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pb_salas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_4"
                    app:indicatorColor="@color/fiea_azul"
                    app:trackColor="@color/contorno"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp" />

                <TextView
                    style="@style/Widget.Fiea.Rotulo"
                    android:layout_marginTop="@dimen/espaco_12"
                    android:labelFor="@+id/spinner_tecnica"
                    android:text="@string/lblTecnica" />

                <!-- Itens e rótulos vêm de ScanActivity.criarAdapterTecnicas -->
                <Spinner
                    android:id="@+id/spinner_tecnica"
                    style="@style/Widget.Fiea.Spinner" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/BtEncerrarSessao"
                style="@style/Widget.Fiea.Botao.Secundario.Perigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_8"
                android:text="@string/btEncerrarSessao"
                android:visibility="gone"
                app:icon="@drawable/ic_stop" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- RF05: as salas da unidade e o andamento de cada uma nesta sessão. Tocar numa sala
         abre a varredura dela (ScanActivity.escolherSala). -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_salas"
        style="@style/Widget.Fiea.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/espaco_12"
        android:layout_weight="1"
        android:visibility="gone"
        app:contentPadding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/espaco_12"
                android:paddingTop="@dimen/espaco_12"
                android:paddingEnd="@dimen/espaco_12">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_meeting_room"
                    android:tint="@color/fiea_azul" />

                <TextView
                    android:id="@+id/tv_titulo_salas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_8"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Fiea.Subtitulo" />

                <!-- Atualizar a lista de salas e reexportar (ScanActivity.abrirMaisAcoes) -->
                <ImageButton
                    android:id="@+id/bt_mais_acoes_salas"
                    android:layout_width="@dimen/alvo_toque"
                    android:layout_height="@dimen/alvo_toque"
                    android:layout_marginTop="-12dp"
                    android:layout_marginEnd="-12dp"
                    android:layout_marginBottom="-12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/descMaisAcoes"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/texto_secundario" />
            </LinearLayout>

            <!-- RF09: enquanto busca os bens da sala que acabou de ser varrida -->
            <LinearLayout
                android:id="@+id/grupo_conferindo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_8"
                android:accessibilityLiveRegion="polite"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/espaco_12"
                android:paddingEnd="@dimen/espaco_12"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminateTint="@color/fiea_azul" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_8"
                    android:text="@string/conferindoBens"
                    android:textAppearance="@style/TextAppearance.Fiea.Legenda"
                    android:textColor="@color/fiea_azul" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/espaco_12"
                android:background="@color/contorno" />

            <ListView
                android:id="@+id/lv_salas_varredura"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/contorno"
                android:dividerHeight="1dp" />

            <!-- Sem salas do PC para a unidade: o operador digita o nome da sala -->
            <LinearLayout
                android:id="@+id/grupo_sala_manual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espaco_12"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_sala_manual_aviso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/et_sala_manual"
                    android:textAppearance="@style/TextAppearance.Fiea.Legenda"
                    android:textColor="@color/alerta_texto" />

                <EditText
                    android:id="@+id/et_sala_manual"
                    style="@style/Widget.Fiea.Campo"
                    android:layout_marginTop="@dimen/espaco_8"
                    android:hint="@string/hintSalaManual"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_varrer_sala"
                    style="@style/Widget.Fiea.Botao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_8"
                    android:text="@string/btVarrerSala"
                    app:icon="@drawable/ic_play_arrow" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- A varredura aberta: contadores, botão de leitura e dica do gatilho. Para sair
         daqui só encerrando a varredura, para nenhuma leitura cair em outra sala. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_varredura"
        style="@style/Widget.Fiea.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_12"
        android:layout_marginTop="@dimen/espaco_12"
        android:layout_marginEnd="@dimen/espaco_12"
        android:visibility="gone"
        app:contentPadding="@dimen/espaco_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_meeting_room"
                    android:tint="@color/fiea_azul" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_8"
                    android:layout_weight="1"
                    android:text="@string/tituloVarredura"
                    android:textAppearance="@style/TextAppearance.Fiea.Subtitulo" />

                <TextView
                    android:id="@+id/tv_chip_varredura"
                    style="@style/Widget.Fiea.Selo"
                    android:visibility="gone" />

                <!-- Limpar e exportar .xls a lista desta sala (ScanActivity.abrirMaisAcoes) -->
                <!-- 48dp de toque; as margens negativas mantêm a linha do título baixa -->
                <ImageButton
                    android:id="@+id/bt_mais_acoes"
                    android:layout_width="@dimen/alvo_toque"
                    android:layout_height="@dimen/alvo_toque"
                    android:layout_marginStart="@dimen/espaco_4"
                    android:layout_marginTop="-12dp"
                    android:layout_marginEnd="-12dp"
                    android:layout_marginBottom="-12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/descMaisAcoes"
                    android:src="@drawable/ic_more_vert"
                    android:tint="@color/texto_secundario" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_varredura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_4"
                android:text="@string/varreduraSemSessao"
                android:textAppearance="@style/TextAppearance.Fiea.Legenda" />

            <LinearLayout
                android:id="@+id/grupo_leitura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_8"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.Fiea.Contador"
                        android:textColor="@color/fiea_azul" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_4"
                        android:text="@string/CardNum"
                        android:textAppearance="@style/TextAppearance.Fiea.Legenda" />

                    <TextView
                        android:id="@+id/tv_alltag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_24"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.Fiea.Contador"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_4"
                        android:text="@string/CardCount"
                        android:textAppearance="@style/TextAppearance.Fiea.Legenda" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_8"
                    android:orientation="horizontal">

                    <!-- Texto, ícone e cor trocam com a leitura (ScanActivity.mostrarEstadoLeitura) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/BtInventory"
                        style="@style/Widget.Fiea.Botao"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:text="@string/btInventory"
                        app:icon="@drawable/ic_contactless" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/BtEncerrarVarredura"
                        style="@style/Widget.Fiea.Botao.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginStart="@dimen/espaco_8"
                        android:contentDescription="@string/btEncerrarVarredura"
                        android:maxLines="1"
                        android:text="@string/btEncerrarVarreduraCurto" />
                </LinearLayout>

                <!-- polite: o leitor de tela avisa quando a leitura começa e para -->
                <TextView
                    android:id="@+id/tv_tips"
                    android:layout_width="match_parent"
                    android:accessibilityLiveRegion="polite"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_8"
                    android:text="@string/dicaGatilho"
                    android:textAppearance="@style/TextAppearance.Fiea.Legenda" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Etiquetas lidas na varredura -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_lista"
        style="@style/Widget.Fiea.Card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/espaco_12"
        android:layout_marginTop="@dimen/espaco_8"
        android:layout_marginEnd="@dimen/espaco_12"
        android:layout_marginBottom="@dimen/espaco_12"
        android:layout_weight="1"
        app:contentPadding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Mesmos pesos das colunas de listtag_items.xml -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/espaco_16"
                android:paddingEnd="@dimen/espaco_16">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="5"
                    android:text="@string/tvTagUii"
                    android:textAppearance="@style/TextAppearance.Fiea.Legenda" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:gravity="center"
                    android:text="@string/tvTagCount"
                    android:textAppearance="@style/TextAppearance.Fiea.Legenda" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:gravity="center"
                    android:text="@string/rotuloRssi"
                    android:textAppearance="@style/TextAppearance.Fiea.Legenda" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/contorno" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- transcriptMode: acompanha as etiquetas novas, que entram no fim da lista -->
                <ListView
                    android:id="@+id/LvTags"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/contorno"
                    android:dividerHeight="1dp"
                    android:transcriptMode="normal" />

                <TextView
                    android:id="@+id/tv_lista_vazia"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="@dimen/espaco_24"
                    android:text="@string/listaVazia"
                    android:textAppearance="@style/TextAppearance.Fiea.Legenda" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Estado das ações do menu "Mais ações". Os botões ficam ocultos: o
         ScanActivity continua habilitando/desabilitando cada um, e o menu copia esse
         estado e reaproveita o mesmo onClick. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <Button
            android:id="@+id/BtClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btClear" />

        <Button
            android:id="@+id/BtImport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btImport" />

        <Button
            android:id="@+id/BtExportCsv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btExportCsv" />
    </LinearLayout>

</LinearLayout>
