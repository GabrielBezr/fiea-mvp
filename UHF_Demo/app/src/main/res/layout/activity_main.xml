<?xml version="1.0" encoding="utf-8"?>
<!-- Casca do app. O TabHost continua sendo a navegação de verdade (cada aba é uma
     Activity). O TabWidget fica oculto, mas não pode sair: o TabHost exige que ele
     exista. A navegação visível é a barra inferior, ligada às abas em MainActivity. -->
<TabHost xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@android:id/tabhost"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fundo"
        android:orientation="vertical">

        <!-- Barra superior. Toque longo no título abre a área de desenvolvedor. -->
        <LinearLayout
            android:id="@+id/barra_superior"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/fiea_azul"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/espaco_4"
            android:paddingEnd="@dimen/espaco_4">

            <ImageButton
                android:id="@+id/bt_sair_dev"
                android:layout_width="@dimen/alvo_toque"
                android:layout_height="@dimen/alvo_toque"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/descSairDev"
                android:src="@drawable/ic_close"
                android:tint="@color/white"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/area_titulo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/espaco_12">

                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/descLogo"
                    android:src="@drawable/logo_fiea" />

                <TextView
                    android:id="@+id/tv_titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_8"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_titulo"
                    android:textAppearance="@style/TextAppearance.Fiea.Titulo"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Situação da conexão com o PC; o toque abre a configuração do servidor -->
            <LinearLayout
                android:id="@+id/layout_conexao_servidor"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/fundo_chip"
                android:backgroundTint="@color/alerta_fundo"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/espaco_8"
                android:paddingEnd="@dimen/espaco_12">

                <ImageView
                    android:id="@+id/iv_status_conexao"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sync"
                    android:tint="@color/alerta_texto" />

                <TextView
                    android:id="@+id/tv_status_conexao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_4"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxWidth="150dp"
                    android:maxLines="1"
                    android:text="@string/conexaoVerificando"
                    android:textColor="@color/alerta_texto"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/bt_config_servidor"
                android:layout_width="@dimen/alvo_toque"
                android:layout_height="@dimen/alvo_toque"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/descConfigServidor"
                android:src="@drawable/ic_settings"
                android:tint="@color/white" />
        </LinearLayout>

        <TabWidget
            android:id="@android:id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <FrameLayout
            android:id="@android:id/tabcontent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/divisor_navegacao"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/contorno" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/navegacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/superficie"
            app:elevation="0dp"
            app:itemIconTint="@color/selector_navegacao"
            app:itemTextAppearanceActive="@style/TextAppearance.Fiea.Navegacao"
            app:itemTextAppearanceInactive="@style/TextAppearance.Fiea.Navegacao"
            app:itemTextColor="@color/selector_navegacao"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/navegacao_principal" />
    </LinearLayout>

</TabHost>
