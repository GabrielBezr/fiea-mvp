<?xml version="1.0" encoding="utf-8"?>
<!-- descendantFocusability + focusableInTouchMode: nenhum campo pega o foco sozinho
     ao abrir a aba, então o teclado não sobe e o leitor de código do DT50 (que digita
     no campo em foco) só escreve onde o operador tocou. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <!-- RF03: liga o EPC da etiqueta ao número de patrimônio, em dois passos -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Fiea.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_12"
        android:layout_marginTop="@dimen/espaco_12"
        android:layout_marginEnd="@dimen/espaco_12"
        app:contentPadding="@dimen/espaco_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Fiea.Rotulo"
                android:labelFor="@+id/et_epc"
                android:text="@string/lblEpc" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_epc"
                    style="@style/Widget.Fiea.Campo"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:hint="@string/hintEpc"
                    android:imeOptions="actionNext"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLines="1"
                    android:singleLine="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/BtLerTag"
                    style="@style/Widget.Fiea.Botao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_8"
                    android:text="@string/btLerTag"
                    app:icon="@drawable/ic_contactless" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_4"
                android:text="@string/dicaQr"
                android:textAppearance="@style/TextAppearance.Fiea.Legenda" />

            <TextView
                style="@style/Widget.Fiea.Rotulo"
                android:layout_marginTop="@dimen/espaco_12"
                android:labelFor="@+id/et_patrimonio"
                android:text="@string/lblPatrimonio" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_patrimonio"
                    style="@style/Widget.Fiea.Campo"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:hint="@string/hintPatrimonio"
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:singleLine="true" />

                <CheckBox
                    android:id="@+id/cb_metalico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_8"
                    android:minHeight="@dimen/alvo_toque"
                    android:text="@string/lblMetalico"
                    android:textColor="@color/texto_primario"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_12"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/BtSalvarPar"
                    style="@style/Widget.Fiea.Botao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btSalvarPar"
                    app:icon="@drawable/ic_check_circle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/BtLimparPar"
                    style="@style/Widget.Fiea.Botao.Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_8"
                    android:text="@string/btLimparPar" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Cadastro de bancada: potência mínima, a tag lida vai para o formulário do PC -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Fiea.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_12"
        android:layout_marginTop="@dimen/espaco_8"
        android:layout_marginEnd="@dimen/espaco_12"
        app:contentPadding="@dimen/espaco_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/espaco_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tituloBancada"
                    android:textAppearance="@style/TextAppearance.Fiea.Subtitulo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dicaBancada"
                    android:textAppearance="@style/TextAppearance.Fiea.Legenda" />
            </LinearLayout>

            <!-- O texto troca enquanto espera a tag (EtiquetagemActivity) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_transmitir_pc"
                style="@style/Widget.Fiea.Botao.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btTransmitirPc"
                app:icon="@drawable/ic_sync" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Etiquetas vinculadas nesta campanha (mais recentes em cima) -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Fiea.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/espaco_12"
        android:layout_weight="1"
        app:contentPadding="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/espaco_16"
                android:paddingTop="@dimen/espaco_8"
                android:paddingEnd="@dimen/espaco_16"
                android:paddingBottom="@dimen/espaco_8">

                <TextView
                    android:id="@+id/tv_etiq_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textAppearance="@style/TextAppearance.Fiea.Corpo" />

                <TextView
                    android:id="@+id/tv_etiq_arquivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Fiea.Legenda" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/contorno" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/lv_pares"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/contorno"
                    android:dividerHeight="1dp" />

                <TextView
                    android:id="@+id/tv_pares_vazio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="@dimen/espaco_24"
                    android:text="@string/paresVazio"
                    android:textAppearance="@style/TextAppearance.Fiea.Legenda" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
