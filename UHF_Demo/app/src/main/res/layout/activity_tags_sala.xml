<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="8dp">

    <!-- Cabeçalho: Sala e Configuração do Servidor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_pend_sala"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sala: (Nenhuma varredura selecionada)"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_config_servidor"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btConfigServidor"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:background="@drawable/color_button_selector"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- Resumo dos Contadores -->
    <TextView
        android:id="@+id/tv_pend_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: 0 bens esperados"
        android:textSize="12sp"
        android:textColor="@color/colorPrimary"
        android:paddingBottom="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray1"
        android:layout_marginBottom="8dp" />

    <!-- Painel de Resolução (RF10: Dropbox com QR Code / Manual / Faltante) -->
    <LinearLayout
        android:id="@+id/layout_painel_resolucao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F1F5F9"
        android:padding="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_item_selecionado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toque em um bem na lista abaixo para resolver:"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Dropbox de Seleção do Método -->
            <Spinner
                android:id="@+id/spinner_metodo_resolucao"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@android:drawable/btn_dropdown"
                android:layout_marginRight="6dp" />

            <Button
                android:id="@+id/btn_executar_acao"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Aplicar"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:background="@drawable/color_button_selector"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Título da Lista -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bens da Sala (Toque para selecionar):"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:paddingBottom="2dp" />

    <!-- Lista de Bens / Pendências -->
    <ListView
        android:id="@+id/lv_pendencias"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/gray1"
        android:dividerHeight="1dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray1"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- Barra Inferior: Sincronização com o Servidor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_sync_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Servidor: Verificando..."
            android:textSize="11sp"
            android:textColor="@color/gray2" />

        <Button
            android:id="@+id/btn_sincronizar_servidor"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Sincronizar com PC"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:background="@drawable/color_button_selector"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
