<?xml version="1.0" encoding="utf-8"?>
<!-- Linha da lista de etiquetas do Inventário. Plana de propósito (sem sombra nem
     card): a lista é atualizada a cada leitura. Os pesos casam com o cabeçalho em
     activity_scan.xml. A cor e o ícone do RSSI vêm de ScanActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/espaco_16"
    android:paddingEnd="@dimen/espaco_16">

    <TextView
        android:id="@+id/TvTagUii"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="5"
        android:paddingTop="@dimen/espaco_4"
        android:paddingBottom="@dimen/espaco_4"
        android:textAppearance="@style/TextAppearance.Fiea.Mono" />

    <TextView
        android:id="@+id/TvTagLen"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:visibility="gone" />

    <TextView
        android:id="@+id/TvTagCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Fiea.Corpo"
        android:textColor="@color/texto_secundario" />

    <TextView
        android:id="@+id/TvTagRssi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:drawablePadding="2dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Fiea.Corpo" />

</LinearLayout>
