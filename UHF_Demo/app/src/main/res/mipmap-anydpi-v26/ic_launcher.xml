<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone do app (minSdk 26: todo aparelho usa este). A frente é um PNG de 108dp com
     a logo já posicionada, porque o launcher escala as camadas para cada tamanho de
     exibição; margens fixas em dp não acompanham essa escala e deformam a logo. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/fiea_azul" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
